---
import Layout from "../layouts/Layout.astro";
import FindMyTown from "../components/FindMyTown.tsx";
import { loadIndex } from "../lib/data";

const { corpus } = loadIndex();
const coveredCount = corpus.cities + corpus.counties;

// Three featured topics for the homepage hook. They link into the /patterns
// explorer with the topic preselected.
const featured = [
  {
    href: "/patterns#dogs",
    emoji: "🐕",
    label: "Dangerous dogs",
    color: "#b4532a",
    hook: "95% judge the dog by behavior. 21% name the breed.",
  },
  {
    href: "/patterns#fireworks",
    emoji: "🎆",
    label: "Fireworks",
    color: "#c79434",
    hook: "A total ban, or just the Fourth of July?",
  },
  {
    href: "/patterns#chickens",
    emoji: "🐔",
    label: "Backyard chickens",
    color: "#7a9e3f",
    hook: "Allowed with limits, zoned to farms, or banned.",
  },
];
---

<Layout>
  <!-- hero: headline + one-line framing + the finder, the core action, up top -->
  <section class="max-w-7xl mx-auto px-6 pt-14 pb-2">
    <div class="max-w-3xl">
      <h1
        class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05]"
      >
        Know your local laws.
      </h1>
    </div>
    <div class="mt-7">
      <FindMyTown client:load />
    </div>
  </section>

  <!-- featured: how the same rule differs from town to town -->
  <section class="max-w-7xl mx-auto px-6 pt-12">
    <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
      Same rule, different town
    </p>
    <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900">
      See how cities handle it differently
    </h2>
    <div class="mt-5 grid gap-3 sm:grid-cols-3 max-w-3xl">
      {
        featured.map((f) => (
          <a
            href={f.href}
            class="group rounded-xl border border-[var(--rule)] bg-white p-4 transition hover:border-ink-300"
            style={`border-top: 2px solid ${f.color}`}
          >
            <div class="flex items-center gap-2">
              <span aria-hidden>{f.emoji}</span>
              <span class="font-medium text-ink-900">{f.label}</span>
            </div>
            <p class="mt-2 text-[13.5px] leading-relaxed text-ink-600">{f.hook}</p>
            <span class="mt-3 inline-block text-[13px] text-accent-600 group-hover:text-accent-700">
              See how cities differ →
            </span>
          </a>
        ))
      }
    </div>
    <a
      href="/patterns#breadth"
      class="mt-4 inline-block text-[13.5px] text-ink-500 hover:text-ink-900"
    >
      Or browse all 47 things cities regulate →
    </a>
  </section>

  <!-- what this is: the fuller explanation, moved down for those who want it -->
  <section id="about" class="max-w-7xl mx-auto px-6 pt-10 scroll-mt-20">
    <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
      What this is
    </p>
    <div class="max-w-3xl">
      <p class="mt-3 text-[16px] leading-relaxed text-ink-600">
        City and county ordinances govern noise, pets, fences, permits, and
        starting a business. They are public, but among the most fragmented law
        in the United States: there is no central index, and every town’s code
        lives on a different site or in a PDF, in its own format.
      </p>
      <p class="mt-3 text-[16px] leading-relaxed text-ink-600">
        <strong class="text-ink-800">LOCUS</strong> is an open dataset, compiled
        and released in June 2026 by
        <strong class="text-ink-800"
          >Denis Peskoff, Joe Barrow, Christopher Vu, and Diag Davenport</strong
        >. They gathered those codes, read them with OCR, and labeled every
        provision into one uniform table. This site is their work made browsable —
        the credit for the data is theirs.
      </p>
      <p class="mt-3 text-[16px] leading-relaxed text-ink-600">
        This site is a view on top of that dataset. It does not compile the data
        or write the law; it renders a readable page for every one of the {coveredCount.toLocaleString()}
        cities and counties LOCUS covers.
      </p>
      <p class="mt-2 text-[13px] text-ink-500">
        Source: <a
          href="https://huggingface.co/datasets/LocalLaws/LOCUS-v1"
          class="underline hover:text-ink-900"
          rel="noopener">LOCUS-v1 on Hugging Face</a
        > · <a
          href="https://arxiv.org/abs/2606.19334"
          class="underline hover:text-ink-900"
          rel="noopener">the paper</a
        > · <a href="/about" class="underline hover:text-ink-900"
          >how this site is built</a
        >.
      </p>
    </div>
  </section>

  <!-- disclaimer: last thing on the page -->
  <section class="max-w-7xl mx-auto px-6 pt-12">
    <div
      class="rounded-lg border border-ink-100 bg-ink-50 px-5 py-4 text-[13px] text-ink-600 max-w-3xl leading-relaxed"
    >
      <span class="font-medium text-ink-800">This is not legal advice.</span>
      The text is scanned (OCR) from source documents, the topic labels and
      scores are machine-generated estimates, and plain-language versions are AI
      paraphrases, not the law itself. There are no effective dates and coverage
      is partial. Always confirm against your jurisdiction’s official code
      before relying on anything here.
    </div>
  </section>
</Layout>
