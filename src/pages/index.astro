---
import Layout from "../layouts/Layout.astro";
import FindMyTown from "../components/FindMyTown.tsx";
import { loadIndex } from "../lib/data";

const { corpus } = loadIndex();
const coveredCount = corpus.cities + corpus.counties;

const stats = [
  { label: "Ordinances", value: corpus.total_laws.toLocaleString() },
  { label: "States", value: corpus.states.toString() },
  { label: "Cities", value: corpus.cities.toLocaleString() },
  { label: "Counties", value: corpus.counties.toLocaleString() },
];
---

<Layout>
  <!-- hero: headline + dataset explainer + stats -->
  <section class="max-w-7xl mx-auto px-6 pt-14 pb-2">
    <h1
      class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] max-w-3xl"
    >
      The local laws where you live, in plain sight.
    </h1>
    <div class="max-w-3xl">
      <p class="mt-4 text-[16px] leading-relaxed text-ink-600">
        City and county ordinances govern noise, pets, fences, permits, and
        starting a business. They are public, but among the most fragmented law
        in the United States: there is no central index, and every town’s code
        lives on a different site or in a PDF, in its own format.
      </p>
      <p class="mt-3 text-[16px] leading-relaxed text-ink-600">
        <strong class="text-ink-800">LOCUS</strong> is an open dataset, released
        in <strong class="text-ink-800">June 2026</strong> by researchers Denis
        Peskoff, Joe Barrow, Christopher Vu, and Diag Davenport. They gathered
        those codes, read them with OCR, and labeled every provision into one
        uniform table.
      </p>
      <p class="mt-3 text-[16px] leading-relaxed text-ink-600">
        This site is a view on top of that dataset. It does not compile the data
        or write the law; it renders a readable page for every one of the {coveredCount.toLocaleString()}
        cities and counties LOCUS covers.
      </p>
      <p class="mt-2 text-[13px] text-ink-500">
        Source: <a
          href="https://huggingface.co/datasets/LocalLaws/LOCUS-v1"
          class="underline hover:text-ink-900"
          rel="noopener">LOCUS-v1 on Hugging Face</a
        > · <a
          href="https://arxiv.org/abs/2606.19334"
          class="underline hover:text-ink-900"
          rel="noopener">the paper</a
        > · <a href="/about" class="underline hover:text-ink-900"
          >how this site is built</a
        >.
      </p>
    </div>

    <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4 max-w-2xl">
      {
        stats.map((s) => (
          <div class="rounded-lg border border-[var(--rule)] bg-white px-5 py-4">
            <div class="font-mono text-2xl text-ink-900">{s.value}</div>
            <div class="mt-1 text-[11px] uppercase tracking-wider text-ink-500">
              {s.label}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- disclaimer, up front -->
  <section class="max-w-7xl mx-auto px-6 pt-7">
    <div
      class="rounded-lg border border-ink-100 bg-ink-50 px-5 py-4 text-[13px] text-ink-600 max-w-3xl leading-relaxed"
    >
      <span class="font-medium text-ink-800">This is not legal advice.</span>
      The text is scanned (OCR) from source documents, the topic labels and
      scores are machine-generated estimates, and plain-language versions are AI
      paraphrases, not the law itself. There are no effective dates and coverage
      is partial. Always confirm against your jurisdiction’s official code
      before relying on anything here.
    </div>
  </section>

  <!-- find your town: the core action -->
  <section class="max-w-7xl mx-auto px-6 pt-14">
    <div class="max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
        Start here
      </p>
      <h2
        class="mt-2 font-display text-2xl md:text-3xl font-semibold text-ink-900 leading-tight"
      >
        Find your town.
      </h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-600">
        Start with the place you live and read its real ordinances — the noise
        rules, the permit lists, the fence heights.
      </p>
    </div>
    <div class="mt-7">
      <FindMyTown client:load />
    </div>
  </section>

  <!-- ways in -->
  <section class="max-w-7xl mx-auto px-6 pt-12">
    <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
      Or explore
    </p>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3 max-w-4xl">
      <a
        href="/map"
        class="group rounded-lg border border-[var(--rule)] bg-white px-5 py-4 transition hover:border-ink-300 hover:shadow-sm"
      >
        <h3
          class="font-display text-[16px] font-semibold text-ink-900 group-hover:text-accent-700"
        >
          Explore cities →
        </h3>
        <p class="mt-1 text-[13px] leading-relaxed text-ink-500">
          Every covered place on a map, plus the largest cities and counties to
          browse.
        </p>
      </a>
      <a
        href="/spectrum"
        class="group rounded-lg border border-[var(--rule)] bg-white px-5 py-4 transition hover:border-ink-300 hover:shadow-sm"
      >
        <h3
          class="font-display text-[16px] font-semibold text-ink-900 group-hover:text-accent-700"
        >
          How laws differ →
        </h3>
        <p class="mt-1 text-[13px] leading-relaxed text-ink-500">
          Two laws can say the same thing in very different ways. Slide across a
          scale and read real examples.
        </p>
      </a>
      <a
        href="/rankings"
        class="group rounded-lg border border-[var(--rule)] bg-white px-5 py-4 transition hover:border-ink-300 hover:shadow-sm"
      >
        <h3
          class="font-display text-[16px] font-semibold text-ink-900 group-hover:text-accent-700"
        >
          Rankings →
        </h3>
        <p class="mt-1 text-[13px] leading-relaxed text-ink-500">
          Where each place sits on the national scale, by how its laws are
          written and what they regulate.
        </p>
      </a>
    </div>
  </section>
</Layout>
