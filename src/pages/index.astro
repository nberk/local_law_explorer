---
import Layout from "../layouts/Layout.astro";
import JurisdictionPicker from "../components/JurisdictionPicker.tsx";
import FindMyTown from "../components/FindMyTown.tsx";
import SpectrumExplorer from "../components/SpectrumExplorer.tsx";
import { loadIndex, loadSpectrum } from "../lib/data";

const { corpus } = loadIndex();
const { spectra } = loadSpectrum();
const coveredCount = corpus.cities + corpus.counties;

const stats = [
  { label: "Ordinances", value: corpus.total_laws.toLocaleString() },
  { label: "States", value: corpus.states.toString() },
  { label: "Cities", value: corpus.cities.toLocaleString() },
  { label: "Counties", value: corpus.counties.toLocaleString() },
];
---

<Layout>
  <!-- hero -->
  <section class="max-w-7xl mx-auto px-6 pt-14 pb-2">
    <h1
      class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] max-w-3xl"
    >
      The local rules where you live, in plain sight.
    </h1>
    <p class="mt-4 max-w-2xl text-[16px] leading-relaxed text-ink-600">
      City and county ordinances govern noise, pets, fences, permits, and
      starting a business. They are public, but scattered and hard to read.
      This site is a viewer for <strong class="text-ink-800">LOCUS</strong>, an
      open dataset of U.S. local law released in <strong class="text-ink-800"
        >June 2026</strong
      > that gathered millions of these ordinances into one place. We don’t write
      or change the law. We just make the data easy to explore.
    </p>
    <p class="mt-2 text-[13px] text-ink-500">
      Source: <a
        href="https://huggingface.co/datasets/LocalLaws/LOCUS-v1"
        class="underline hover:text-ink-900"
        rel="noopener">LOCUS-v1 on Hugging Face</a
      > · <a
        href="https://arxiv.org/abs/2606.19334"
        class="underline hover:text-ink-900"
        rel="noopener">the paper</a
      > · <a href="/about" class="underline hover:text-ink-900"
        >how this site is built</a
      >.
    </p>

    <form action="/search" method="get" class="mt-6 relative max-w-xl">
      <input
        type="text"
        name="q"
        placeholder="Ask about a local law… e.g. “can I keep chickens?”"
        autocomplete="off"
        class="w-full rounded-lg border border-ink-200 bg-white px-4 py-3 pr-24 text-[15px] placeholder:text-ink-400 focus:border-accent-500 focus:outline-none"
      />
      <button
        type="submit"
        class="absolute right-1.5 top-1.5 rounded-md bg-ink-900 px-4 py-1.5 text-[14px] font-medium text-white transition hover:bg-ink-700"
      >
        Search
      </button>
    </form>
  </section>

  <!-- interactive spectra -->
  <section class="max-w-7xl mx-auto px-6 pt-12">
    <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
      Explore
    </p>
    <h2
      class="mt-2 font-display text-2xl md:text-3xl font-semibold text-ink-900 leading-tight max-w-3xl"
    >
      The law isn’t one thing. Slide across it.
    </h2>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-600">
      Every ordinance in the corpus is scored on a few dimensions. Drag the
      handle to travel from one extreme to the other and read a real law at each
      stop, with a plain-language version alongside the original.
    </p>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <SpectrumExplorer client:load dimKey="opacity" laws={spectra.opacity.laws} />
      <SpectrumExplorer
        client:load
        dimKey="paternalism"
        laws={spectra.paternalism.laws}
      />
    </div>
  </section>

  <!-- find your town -->
  <section class="max-w-7xl mx-auto px-6 pt-16">
    <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
      Go local
    </p>
    <h2
      class="mt-2 font-display text-2xl md:text-3xl font-semibold text-ink-900 leading-tight"
    >
      Find your town.
    </h2>
    <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-ink-600">
      Each place opens with a portrait of how it governs compared with the rest
      of the country, then everyday questions, notable rules, and the full code
      to browse.
    </p>
    <div class="mt-6">
      <FindMyTown client:load />
    </div>
    <div class="mt-10">
      <JurisdictionPicker client:load />
    </div>
  </section>

  <!-- corpus scale -->
  <section class="max-w-7xl mx-auto px-6 pt-16">
    <div class="max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
        The dataset
      </p>
      <h2
        class="mt-2 font-display text-2xl md:text-3xl font-semibold text-ink-900 leading-tight"
      >
        The most scattered law in America, gathered in one place.
      </h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-600">
        Local ordinances are the most fragmented body of law in the United
        States. There is no central index. Every town’s code lives on a
        different site or in a PDF, in its own format. The open LOCUS corpus
        gathered these codes, read them with OCR, and labeled every provision
        into one uniform table. This site renders a detailed page for every one
        of the {coveredCount.toLocaleString()} cities and counties in it.
      </p>
    </div>

    <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4 max-w-2xl">
      {
        stats.map((s) => (
          <div class="rounded-lg border border-[var(--rule)] bg-white px-5 py-4">
            <div class="font-mono text-2xl text-ink-900">{s.value}</div>
            <div class="mt-1 text-[11px] uppercase tracking-wider text-ink-500">
              {s.label}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- disclaimer -->
  <section class="max-w-7xl mx-auto px-6 pt-8">
    <div
      class="rounded-lg border border-ink-100 bg-ink-50 px-5 py-4 text-[13px] text-ink-600 max-w-3xl leading-relaxed"
    >
      <span class="font-medium text-ink-800">This is not legal advice.</span>
      The text is scanned (OCR) from source documents, the topic labels and
      scores are machine-generated estimates, and plain-language versions are AI
      paraphrases, not the law itself. There are no effective dates and coverage
      is partial. Always confirm against your jurisdiction’s official code
      before relying on anything here.
    </div>
  </section>
</Layout>
