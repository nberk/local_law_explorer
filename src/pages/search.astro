---
import Layout from "../layouts/Layout.astro";
import GlobalSearch from "../components/GlobalSearch.tsx";
import { loadIndex } from "../lib/data";

const { jurisdictions } = loadIndex();
---

<Layout
  title="Ask the law — Local Law Lookup"
  description="Ask a plain-language question and find the local ordinances most related to it, across the pilot cities. Not legal advice."
>
  <section class="max-w-3xl mx-auto px-6 pt-14 pb-2">
    <p class="font-mono text-[11px] uppercase tracking-wider text-ink-500">
      Ask anything
    </p>
    <h1
      class="mt-2 font-display text-3xl md:text-4xl font-semibold text-ink-900 leading-[1.1]"
    >
      Ask a question. See the laws that touch it.
    </h1>
    <p class="mt-3 text-[15px] leading-relaxed text-ink-600">
      Type a plain-language question and we’ll find the ordinances most related
      to it across all {jurisdictions.length} pilot cities, ranked by meaning. We
      surface the real law text — never a written answer, and never legal advice.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pt-6 pb-16">
    <GlobalSearch client:load />
  </section>
</Layout>
