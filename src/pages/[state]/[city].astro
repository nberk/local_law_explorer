---
import Layout from "../../layouts/Layout.astro";
import JurisdictionModules from "../../components/JurisdictionModules.tsx";
import TopicFingerprint from "../../components/TopicFingerprint.astro";
import { loadIndex, loadBaselines } from "../../lib/data";

export function getStaticPaths() {
  const { jurisdictions } = loadIndex();
  return jurisdictions.map((j) => {
    const [state, city] = j.id.split("/");
    return { params: { state, city }, props: { j } };
  });
}

const { j } = Astro.props;
const stateSlug = j.id.split("/")[0];
const baselines = loadBaselines();
const medians = Object.fromEntries(
  Object.entries(baselines.topicShares).map(([t, v]) => [t, v.breakpoints[50] ?? 0]),
);
---

<Layout
  title={`${j.name}, ${j.state} — Local Law Explorer`}
  description={`Browse the local ordinances of ${j.name}, ${j.stateName}: everyday rules, business permits, and renting & property. Built on the LOCUS corpus. Not legal advice.`}
>
  <section class="max-w-5xl mx-auto px-6 pt-8">
    <nav class="text-[12px] text-ink-400">
      <a href="/" class="hover:text-ink-900">Home</a>
      <span class="mx-1.5">/</span>
      <a href={`/${stateSlug}`} class="text-ink-500 hover:text-ink-900"
        >{j.stateName}</a
      >
      <span class="mx-1.5">/</span>
      <span class="text-ink-700">{j.name}</span>
    </nav>

    <div class="mt-3 flex items-end justify-between gap-4 flex-wrap">
      <div>
        <h1 class="font-display text-4xl font-semibold text-ink-900 leading-tight">
          {j.name}
        </h1>
        <p class="mt-1 text-[14px] text-ink-500">
          {j.stateName} · <span class="font-mono text-ink-700"
            >{j.counts.total.toLocaleString()}</span
          > local laws on record
        </p>
      </div>
    </div>

    <!-- disclaimer banner -->
    <div
      class="mt-5 rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-[12.5px] text-ink-600 leading-relaxed"
    >
      Scanned text with machine-generated labels, no effective dates, partial
      coverage. <span class="font-medium text-ink-800">Not legal advice</span> —
      verify against the official {j.name} code.
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pt-4 pb-8">
    <JurisdictionModules client:load jurisId={j.id} />

    <!-- topic composition vs. the typical US town (demoted to the bottom: most
         readers care about the rules, not the share of code by category) -->
    <div class="mt-12 border-t border-[var(--rule)] pt-8">
      <h2 class="font-display text-[20px] font-semibold text-ink-900">
        What {j.name}’s code is about
      </h2>
      <p class="mt-1 max-w-2xl text-[13.5px] leading-relaxed text-ink-500">
        The share of {j.name}’s ordinances in each topic, next to a tick for the
        typical U.S. town. Topics are noisy machine labels, so read this as a
        rough shape, not an exact accounting.
      </p>
      <div class="mt-4">
        <TopicFingerprint counts={j.counts} medians={medians} />
      </div>
    </div>
  </section>
</Layout>
