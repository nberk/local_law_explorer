---
const links = [
  // "Find your town" is redundant with the logo (both → home), so hide it on
  // mobile; keep the rest reachable everywhere (mobile had no nav before).
  { href: "/", label: "Find your town", mobileHidden: true },
  { href: "/map", label: "Explore cities", mobileHidden: false },
  { href: "/about", label: "About", mobileHidden: false },
];
const path = Astro.url.pathname;
---

<header
  class="border-b border-[var(--rule)] bg-[var(--bg)]/80 backdrop-blur sticky top-0 z-30"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center gap-6 sm:gap-9">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <span
        class="w-6 h-6 rounded-sm bg-ink-900 text-white grid place-items-center font-display text-[13px] leading-none"
        >L</span
      >
      <span
        class="hidden xs:inline font-display text-[15px] font-semibold text-ink-900"
        >Local Laws</span
      >
    </a>
    <nav
      class="flex items-center gap-4 sm:gap-5 text-[13.5px] flex-1 min-w-0 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [-ms-overflow-style:none]"
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            class={
              (l.mobileHidden ? "hidden md:inline " : "") +
              "shrink-0 transition hover:text-ink-900 " +
              (path === l.href ? "text-ink-900 font-medium" : "text-ink-500")
            }
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
