---
// What a town's code is *about*. A donut shows the composition — each topic's
// share of this town's code reads instantly as a wedge. The comparison a donut
// can't carry (is this town heavy or light on a topic vs. a typical U.S. town?)
// is laid onto the legend: each row shows the town's share, the typical share,
// and an over/under cue. Server-rendered (no JS), pure SVG.
import { TOPICS, TOPIC_COLOR } from "../lib/topics";

interface Props {
  counts: Record<string, number>;
  medians: Record<string, number>; // national median share per topic
}
const { counts, medians } = Astro.props;
const total = counts.total || 1;

const rows = TOPICS.map((t) => {
  const share = (counts[t] || 0) / total;
  const median = medians[t] ?? 0;
  // relative weight vs. a typical town, for the plain-language cue
  const ratio = median > 0 ? share / median : 1;
  return { topic: t, n: counts[t] || 0, share, median, ratio };
})
  .filter((r) => r.n > 0)
  .sort((a, b) => b.share - a.share);

const pct = (v: number) => `${Math.round(v * 100)}%`;

function cue(ratio: number): { label: string; glyph: string; cls: string } {
  if (ratio >= 1.4)
    return { label: "more than typical", glyph: "▲", cls: "text-accent-700" };
  if (ratio <= 0.7)
    return { label: "less than typical", glyph: "▼", cls: "text-ink-500" };
  return { label: "about typical", glyph: "•", cls: "text-ink-400" };
}

// Donut geometry. Arcs are drawn as dashed strokes on concentric circles,
// rotated so the first wedge starts at 12 o'clock.
const size = 176;
const stroke = 30;
const r = (size - stroke) / 2;
const C = 2 * Math.PI * r;
const cx = size / 2;
const cy = size / 2;
let acc = 0;
const arcs = rows.map((row) => {
  const len = row.share * C;
  const arc = {
    color: TOPIC_COLOR[row.topic],
    dash: len,
    offset: -acc * C,
  };
  acc += row.share;
  return arc;
});
---

<div class="flex flex-col items-start gap-7 sm:flex-row sm:items-center sm:gap-9">
  <!-- donut: this town's composition -->
  <div class="relative shrink-0" style={`width:${size}px;height:${size}px`}>
    <svg
      viewBox={`0 0 ${size} ${size}`}
      width={size}
      height={size}
      role="img"
      aria-label="Share of this town's code by topic"
    >
      <circle
        cx={cx}
        cy={cy}
        r={r}
        fill="none"
        stroke="var(--rule)"
        stroke-width={stroke}
      />
      <g transform={`rotate(-90 ${cx} ${cy})`}>
        {
          arcs.map((a) => (
            <circle
              cx={cx}
              cy={cy}
              r={r}
              fill="none"
              stroke={a.color}
              stroke-width={stroke}
              stroke-dasharray={`${a.dash} ${C - a.dash}`}
              stroke-dashoffset={a.offset}
            />
          ))
        }
      </g>
    </svg>
    <div
      class="absolute inset-0 flex flex-col items-center justify-center text-center"
    >
      <span class="font-mono text-[19px] leading-none text-ink-900"
        >{counts.total.toLocaleString()}</span
      >
      <span class="mt-1 text-[10px] uppercase tracking-wider text-ink-400"
        >laws</span
      >
    </div>
  </div>

  <!-- legend: share + comparison to a typical U.S. town -->
  <ul class="w-full min-w-0 flex-1 space-y-3">
    {
      rows.map((row) => {
        const c = cue(row.ratio);
        return (
          <li>
            <div class="flex items-center gap-2">
              <span
                class="inline-block h-2.5 w-2.5 shrink-0 rounded-sm"
                style={`background:${TOPIC_COLOR[row.topic]}`}
              />
              <span class="flex-1 truncate text-[13px] text-ink-800">
                {row.topic}
              </span>
              <span class="font-mono text-[13px] tabular-nums text-ink-900">
                {pct(row.share)}
              </span>
            </div>
            <div class="mt-0.5 pl-[18px] text-[11px]">
              <span class={c.cls}>
                {c.glyph} {c.label}
              </span>
              <span class="text-ink-400"> · typical {pct(row.median)}</span>
            </div>
          </li>
        );
      })
    }
  </ul>
</div>
